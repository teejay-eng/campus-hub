# MySQL connection string (remote example — set real values in Vercel Environment Variables)
# DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME"

# Vercel production (required)
# NEXTAUTH_URL="https://your-app.vercel.app"

# Session secret — generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"
# NextAuth middleware also reads this (use the same value as AUTH_SECRET)
NEXTAUTH_SECRET="your-auth-secret-here"

# Public app URL (optional, for production)
NEXTAUTH_URL="http://localhost:3000"
