# MySQL connection string
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/compass_hub"

# Session secret — generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"
# NextAuth middleware also reads this (use the same value as AUTH_SECRET)
NEXTAUTH_SECRET="your-auth-secret-here"

# Public app URL (optional, for production)
NEXTAUTH_URL="http://localhost:3000"
